    { "html": "<div class=\"cols\">\n  <div class=\"shot reveal\">\n    <div class=\"shot-bar\"><span class=\"r\"></span><span class=\"y\"></span><span class=\"g\"></span><em>设置 · 启动</em></div>\n    <img src=\"assets/05.png\" alt=\"\">\n  </div>\n  <div class=\"setlist\">\n    <div class=\"set-item reveal\"><span class=\"set-k\">默认配置文件</span><span class=\"set-v\">PowerShell 7</span></div>\n    <div class=\"set-item reveal\"><span class=\"set-k\">启动大小</span><span class=\"set-v pop\">100 × 25</span></div>\n    <div class=\"set-item reveal\"><span class=\"set-k\">开机自启</span><span class=\"set-v\">开</span></div>\n  </div>\n</div>" },
